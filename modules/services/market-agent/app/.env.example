# Where briefs, the SQLite database and downloaded photos live.
# Default: ~/.local/share/market-agent
MARKET_AGENT_HOME=

# Who scores the candidates:
#   cli  - shell out to the `claude` CLI (uses its existing login; the default)
#   api  - Anthropic Python SDK (needs ANTHROPIC_API_KEY or an `ant auth login` profile)
#   none - skip judging; fact checks and hard limits only
MARKET_AGENT_JUDGE=cli
MARKET_AGENT_MODEL=claude-opus-5-5
MARKET_AGENT_CLAUDE_BIN=claude
# How many judge calls run at once.
MARKET_AGENT_JUDGE_CONCURRENCY=3

# Optional residential proxy for Facebook requests (datacenter IPs get throttled).
# http://user:pass@host:port — keep real values out of git.
MARKET_AGENT_PROXY=

# Optional OSRM server for real driving distances. Without it, distance is
# straight-line miles x 1.3. Listing and home coordinates are sent to it, so
# point it at a server you run, not a public demo.
MARKET_AGENT_OSRM_URL=

# Seconds between Facebook requests. Be polite; this is a logged-out scraper.
MARKET_AGENT_FB_INTERVAL=1.5
